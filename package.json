{
  "name": "opencode-jev-supervisor",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Durable professional workflow supervision for OpenCode with Jev Choice",
  "exports": {
    ".": "./dist/opencode/plugin.js"
  },
  "scripts": {
    "build": "node scripts/build/clean-build.mjs && tsc -p tsconfig.json && node scripts/build/copy-workflows.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/core/*.test.ts tests/jev/*.test.ts tests/opencode/*.test.ts",
    "check": "npm run typecheck && npm test",
    "install:local": "npm run build && node scripts/install.mjs",
    "usage:jev": "tsx scripts/cli/jev-usage.ts",
    "workflow:check": "tsx scripts/cli/check-workflow.ts",
    "smoke:jev": "tsx scripts/smoke/smoke-jev.ts",
    "smoke:opencode": "tsx scripts/smoke/smoke-opencode.ts"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.30",
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
